[Unit]
Description=Apply the silverblue-asahi Brewfile once the account exists and the network is up

[Timer]
# Starts silverblue-asahi-brew-setup.service 30s into every boot, then again 2 minutes after each run
# its conditions skipped (GNOME Initial Setup has not created the account yet, or Homebrew's hosts do
# not answer over HTTPS yet). A run that fails is the service's own business: it restarts with a
# growing delay and stays "activating" meanwhile (RestartMode=direct), so this timer does not fire on
# top of it. A run that succeeds, including the instant no-op once the Brewfile has been applied,
# stays active (RemainAfterExit=yes), so the timer is done for this boot.
OnBootSec=30s
OnUnitInactiveSec=2min
# The default AccuracySec=1min would let each start slip by up to a minute.
AccuracySec=10s

[Install]
WantedBy=timers.target
